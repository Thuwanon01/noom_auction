<% content_for :title, "เข้าสู่ระบบ · Noom Auction" %>
<main class="auth">
  <div class="auth__box">
    <%= link_to root_path, class: "auth__brand" do %>Noom <span>Auction</span><% end %>
    <h1 class="auth__title">เข้าสู่ระบบ</h1>
    <p class="auth__sub">ใช้บัญชีของคุณเพื่อเข้าร่วมประมูล</p>
    <%= form_with url: login_path, class: "form" do |f| %>
      <label class="field"><span class="field__label">Email</span>
        <%= f.email_field :email, value: @email, class: "input", placeholder: "you@example.com", required: true, autocomplete: "username", autofocus: true %>
      </label>
      <label class="field"><span class="field__label">Password</span>
        <%= f.password_field :password, class: "input", required: true, autocomplete: "current-password" %>
      </label>
      <%= f.button "Login", class: "btn btn--primary btn--block" %>
    <% end %>
    <p class="auth__alt">ยังไม่มีบัญชี? <%= link_to "สมัครสมาชิก", register_path %></p>
  </div>
</main>
