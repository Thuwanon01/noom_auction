<%= render layout: "onboarding/shell", locals: { step: 1, title: OnboardingController::STEP_TITLES[1] } do %>
  <%= form_with url: onboarding_step_path(1), method: :post, class: "form" do |f| %>
    <div class="form__actions">
      <% if 1 > 1 %><%= link_to "ย้อนกลับ", onboarding_step_path(0), class: "btn btn--ghost" %><% end %>
      <%= f.button "ถัดไป", class: "btn btn--primary" %>
    </div>
  <% end %>
<% end %>
