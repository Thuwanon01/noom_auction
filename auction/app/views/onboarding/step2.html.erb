<%= render layout: "onboarding/shell", locals: { step: 2, title: OnboardingController::STEP_TITLES[2] } do %>
  <%= form_with url: onboarding_step_path(2), method: :post, class: "form" do |f| %>
    <div class="form__actions">
      <% if 2 > 1 %><%= link_to "ย้อนกลับ", onboarding_step_path(1), class: "btn btn--ghost" %><% end %>
      <%= f.button "ถัดไป", class: "btn btn--primary" %>
    </div>
  <% end %>
<% end %>
