<% content_for :title, "รายการประมูล · Noom Auction" %>

<div class="shop">
  <%= render "shared/sidebar", active: :events %>

  <main class="shop__main" data-controller="catalog">
    <header class="shop__top">
      <div>
        <h1 class="shop__title">Event</h1>
        <p class="shop__subtitle">รายการสินค้าที่เปิดประมูล</p>
      </div>
      <div class="shop__actions">
        <%= link_to "+ Create Event", new_event_path, class: "btn btn--primary" %>
        <%= render "shared/profile" %>
      </div>
    </header>

    <%= form_with url: auctions_path, method: :get, id: "catalog-filters", class: "search", role: "search",
          data: { turbo_frame: "catalog", turbo_action: "advance", catalog_target: "form", action: "formdata->catalog#compact" } do %>
      <%= search_field_tag :q, @search.q, class: "input search__input", placeholder: "ค้นหาชื่อสินค้าหรือหมวดหมู่",
            autocomplete: "off", aria: { label: "ค้นหา" }, data: { catalog_target: "query", action: "input->catalog#search" } %>
      <%= button_tag "ค้นหา", type: "submit", name: nil, class: "btn btn--ghost" %>
    <% end %>

    <%= turbo_frame_tag "catalog", data: { turbo_action: "advance", action: "turbo:frame-load->catalog#sync" } do %>
      <%= render "filters" %>

      <% if @load_error %>
        <div class="empty empty--error" role="alert">
          <p>โหลดข้อมูลไม่สำเร็จ</p>
          <%= link_to "ลองอีกครั้ง", auctions_path(request.query_parameters), class: "btn btn--ghost", data: { turbo_frame: "_top" } %>
        </div>
      <% elsif @auctions.empty? %>
        <div class="empty">
          <% if @any_auctions %>
            <p>ไม่พบรายการที่ตรงกับเงื่อนไข</p>
            <%= link_to "ล้างตัวกรองทั้งหมด", auctions_path(catalog_params(@search, q: nil, status: nil, type: nil, category: nil, price: nil)), class: "btn btn--ghost" %>
          <% else %>
            <p>ยังไม่มีรายการประมูล</p>
          <% end %>
        </div>
      <% else %>
        <p class="results-count"><%= number_with_delimiter(@search.total) %> รายการ</p>
        <div class="grid">
          <%= render partial: "card", collection: @auctions, as: :auction, locals: { now: @search.now } %>
        </div>
        <%= render "pager" %>
      <% end %>
    <% end %>
  </main>
</div>
