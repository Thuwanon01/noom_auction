<% a = @auction %>
<% product = a.product %>
<% phase = a.phase(@now) %>
<% content_for :title, "#{product.name} · Noom Auction" %>
<div class="shop">
  <%= render "shared/sidebar", active: :events %>
  <main class="shop__main">
    <header class="shop__top">
      <div>
        <p class="crumb"><%= link_to "Event", back_to_catalog_path %> / <%= product.category_label %></p>
        <h1 class="shop__title"><%= product.name %></h1>
      </div>
      <div class="shop__actions"><%= render "shared/profile" %></div>
    </header>

    <div class="detail">
      <%= render "gallery", product: product %>

      <div>
        <p class="detail__badges">
          <span class="badge badge--static badge--<%= phase %>"><%= phase_label(phase) %></span>
          <span class="tag"><%= auction_type_label(a.auction_type) %></span>
        </p>
        <h2 class="detail__title"><%= product.name %></h2>
        <dl class="facts">
          <div><dt>หมวดหมู่</dt><dd><%= product.category_label %></dd></div>
          <div><dt>สภาพ</dt><dd><%= product.condition_label.presence || "-" %></dd></div>
          <div><dt>ผู้ขาย</dt><dd><%= mask_name(product.seller.name) %></dd></div>
          <div><dt>เริ่ม</dt><dd><%= thai_datetime(a.start_at) %></dd></div>
          <div><dt>ปิด</dt><dd><%= thai_datetime(a.stop_at) %></dd></div>
        </dl>

        <%= render "price_box", auction: a, phase: phase %>
        <%= render "action_area", auction: a, state: @action_state %>
      </div>
    </div>

    <%= render "description", product: product %>
    <%= render "bid_history", auction: a, bids: @bids, now: @now %>
  </main>
</div>
