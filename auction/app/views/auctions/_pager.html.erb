<%# Pagination (M3.5). Keeps every filter param. %>
<% search = @search %>
<% if search.total_pages > 1 %>
  <nav class="pager" aria-label="หน้า">
    <% if search.page > 1 %>
      <%= link_to "‹ ก่อนหน้า", auctions_path(catalog_params(search, page: search.page - 1)), class: "pager__link", rel: "prev" %>
    <% end %>
    <% (1..search.total_pages).each do |p| %>
      <%= link_to p, auctions_path(catalog_params(search, page: p)), class: ["pager__link", ("pager__link--on" if p == search.page)], aria: { current: ("page" if p == search.page) } %>
    <% end %>
    <% if search.page < search.total_pages %>
      <%= link_to "ถัดไป ›", auctions_path(catalog_params(search, page: search.page + 1)), class: "pager__link", rel: "next" %>
    <% end %>
  </nav>
<% end %>
